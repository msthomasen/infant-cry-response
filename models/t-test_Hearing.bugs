data 
{
  # Dimensions of participant information and trial-level data
  Dp <- dim(p_info)
  Dt <- dim(Y)
}

model 
{
  # Population-level priors
  delta ~ dt(0, 1, 1)
  mu ~ dt(0, 1, 1)
  sigma ~ dt(0, 1, 1)T(0,)

  # Gender-specific population means
  # delta represents the standardised Female - Male difference
  a <- (delta * sigma) / 2
  tau <- 1 / (sigma * sigma)

  mu_gender[1] <- mu - a  # Male
  mu_gender[2] <- mu + a  # Female

  # Participant-level hearing thresholds
  for (i in 1:Dp[1])
  {
    mu_i[i] ~ dnorm(mu_gender[p_info[i,2]], tau)

    tau_i[i] ~ dexp(1)

    for (f in 1:n_freq)
    {
      mu_f[i,f] ~ dnorm(mu_i[i], tau_i[i])
    }
  }

  # Trial-level hearing-threshold observations with censoring
  for (i in 1:Dt[1])
  {
    cens[i] ~ dinterval(Y[i,5], BP)
    Y[i,5] ~ dnorm(mu_f[Y[i,1], Y[i,3]], tau_i[Y[i,1]])
  }

  # Disconnected prior-reference draws
  delta_prior ~ dt(0, 1, 1)
  mu_prior ~ dt(0, 1, 1)
  sigma_prior ~ dt(0, 1, 1)T(0,)

  a_prior <- (delta_prior * sigma_prior) / 2
  tau_prior <- 1 / (sigma_prior * sigma_prior)

  mu_gender_prior[1] <- mu_prior - a_prior  # Male
  mu_gender_prior[2] <- mu_prior + a_prior  # Female
}